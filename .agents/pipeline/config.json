{
  "version": 1,
  "git": {
    "remote": "origin",
    "base": "origin/main",
    "issue_pattern": "",
    "commit_types": [
      "feat",
      "fix",
      "test",
      "docs",
      "build",
      "chore",
      "refactor",
      "perf",
      "ci",
      "style"
    ],
    "allow_coauthors": false
  },
  "paths": {
    "production": [
      "*.kt"
    ],
    "tests": [
      "*/src/commonTest/*",
      "*/src/jvmTest/*",
      "*/src/iosTest/*",
      "*/src/test/*",
      "*/src/androidTest/*",
      "*/src/debug/*"
    ],
    "feature_tests": [
      "*Test.kt"
    ],
    "test_exclude": [
      "*/src/androidTest/*"
    ],
    "generated": [
      "*/build/*",
      "build/*"
    ],
    "non_code": [
      ".work",
      ".claude",
      ".agents",
      "scripts/pipeline",
      "docs/mockups"
    ],
    "dependencies": [
      "gradle/libs.versions.toml",
      "*.gradle.kts",
      "gradle/wrapper/gradle-wrapper.properties"
    ]
  },
  "package_marker": "",
  "commands": {
    "test": "scripts/pipeline/gradle.sh test",
    "coverage": "scripts/pipeline/gradle.sh coverage",
    "analyze": "scripts/pipeline/gradle.sh analyze",
    "analyzer_report": "scripts/pipeline/gradle.sh analyzer-report",
    "setup": "cp \"$(git rev-parse --path-format=absolute --git-common-dir)/../local.properties\" . 2>/dev/null || true",
    "dependencies": "true",
    "full_test": "make test"
  },
  "coverage": {
    "lcov": "build/reports/kover/pipeline.lcov"
  },
  "budgets": {
    "added": 300,
    "newFiles": 3,
    "newSymbols": 8
  },
  "localization": {
    "files": {},
    "metadata_prefix": "@"
  },
  "generate": [],
  "patterns": {
    "compile_error": "^e: |Compilation error|Unresolved reference|Could not compile",
    "test_description": "\\bfun\\s+(`)(.*?)`",
    "comment": "^\\s*(//|/\\*|\\*)",
    "rules": [
      [
        "print",
        "(?<![\\w.])(println|print)\\("
      ],
      [
        "todo",
        "\\bTODO\\b"
      ],
      [
        "stack-trace",
        "\\.printStackTrace\\("
      ],
      [
        "debug-log",
        "\\bLog\\.(v|d)\\("
      ]
    ],
    "mechanical_codes": [
      "UnusedImport",
      "UnusedPrivateClass",
      "UnusedPrivateFunction",
      "UnusedPrivateProperty",
      "UnusedPrivateMember",
      "UnusedParameter",
      "UnusedVariable",
      "UnreachableCode",
      "UnreachableCatchBlock"
    ],
    "defensive_patterns": [
      [
        "try",
        "\\btry\\s*\\{"
      ],
      [
        "catch",
        "\\bcatch\\s*\\("
      ],
      [
        "run-catching",
        "\\brunCatching\\b"
      ],
      [
        "elvis",
        "\\?:"
      ],
      [
        "null-check",
        "[!=]=\\s*null\\b"
      ],
      [
        "require",
        "\\b(require|check|requireNotNull|checkNotNull)\\s*[({]"
      ],
      [
        "or-null",
        "\\b\\w+OrNull\\("
      ]
    ],
    "boundary_import": "^import\\s+(androidx\\.sqlite\\.|android\\.(content|app|service|provider|database|os)\\.|android\\.service\\.notification\\.|java\\.io\\.|okio\\.|kotlin\\.time\\.Clock|kotlinx\\.datetime\\.Clock|kotlin\\.system\\.)",
    "kinds": [
      [
        "db-read",
        "\\bdb\\.\\w+\\(|\\b(prepare|execSQL|step)\\("
      ],
      [
        "lazy-list",
        "\\b(LazyColumn|LazyRow|LazyVerticalGrid|LazyVerticalStaggeredGrid)\\b"
      ],
      [
        "canvas",
        "\\bCanvas\\(|\\.drawBehind\\b|\\bdrawWithCache\\b"
      ],
      [
        "text-measure",
        "\\brememberTextMeasurer\\(|\\.measure\\("
      ]
    ],
    "loop": "\\bfor\\s*\\(|\\.(map|mapNotNull|filter|forEach|fold|reduce|flatMap|sortedBy|sortedByDescending|sortedWith|groupBy|sumOf|associate\\w*|count)\\s*[({]",
    "public_symbols": [
      "^(?!private\\b)(@\\w+\\s+)*((public|internal|override|data|value|enum|sealed|abstract|open|inline|suspend|operator|infix|fun)\\s+)*(class|object|interface|typealias)\\s+[A-Z]",
      "^(?!private\\b|override\\b)(@\\w+\\s+)*((public|internal|inline|suspend|operator|infix)\\s+)*fun\\s+"
    ],
    "symbol_exclude": "^(if|for|while|when|catch|return|require|check)\\s*\\(",
    "performance_context": "@Composable",
    "repro_file": "Repro_{slug}_r{round}_{n}Test.kt",
    "performance_loop_kind": "loop-in-composable",
    "analyzer_finding": "^(?P<code>\\w+) (?P<path>[^\\s:]+):(?P<line>\\d+) (?P<message>.*)$"
  },
  "rules": {
    "implementation": "Follow AGENTS.md (Codin' Dirty: few files, few types, data and transformations; one Db; value classes; zero is initialization) and docs/architecture.md D-rows. UI text in pt-BR inline in Compose, with the docs/glossary.md vocabulary (terms in its 'Evitar' column are bugs). Tests follow .agents/rules/testing.md; testTags per D35.",
    "io_boundaries": [
      "SQLite (androidx.sqlite SQLiteDriver/SQLiteConnection) inside Db.kt",
      "Android NotificationListenerService and notification extras (NoticeListener)",
      "Android Context, Intents, permissions and lifecycle",
      "Files: backup/import (cobudget), OFX/CSV reading",
      "Clock / today (kotlinx.datetime Clock, TimeZone)"
    ],
    "mr-review": "Margem review rules live in .agents/skills/margem-review/SKILL.md. Apply that file: the section \"Regra de evidência — não especular\" in full, the \"Regras comuns\" of its step 4 fan-out, and the dimension(s) named by the caller (\"Agente N — …\"). Use docs/spec.md, docs/glossary.md and docs/architecture.md as the sources of truth. Cite file:line for every finding.",
    "simplification-review": "Margem simplification rules live in .agents/skills/simplification-review/SKILL.md: calibrate by AGENTS.md (Codin' Dirty) and the decisions in docs/architecture.md (Db único, value classes, objetos de tags, zero como inicialização). It looks for complexity the problem does not need, not bugs or style.",
    "commits": "Conventional commits, short subject (see .agents/skills/caveman-commit/SKILL.md). No Co-Authored-By or AI attribution lines in this repository."
  },
  "workflow": {
    "candidates": 3,
    "review_rounds": 3,
    "verify_rounds": 3,
    "question_rounds": 3,
    "small_fix_lines": 5,
    "cluster_size": 3,
    "max_proposals": 5,
    "metrics_min_features": 5,
    "lenses": [
      {
        "key": "correctness",
        "agent": "Agente 1 — Corretude & regressões"
      },
      {
        "key": "db",
        "agent": "Agente 2 — Db, SQL e schema"
      },
      {
        "key": "state",
        "agent": "Agente 6 — Compose, estado e ciclo de vida"
      }
    ],
    "fix_matrix": {
      "common": {
        "critical": "fix",
        "major": "fix",
        "minor": "fix-small"
      },
      "occasional": {
        "critical": "fix",
        "major": "fix",
        "minor": "fix-small"
      },
      "rare": {
        "critical": "fix",
        "major": "fix-small",
        "minor": "report"
      },
      "test-only": {
        "critical": "report",
        "major": "report",
        "minor": "report"
      }
    }
  }
}
